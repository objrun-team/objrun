        {
          "name": "role",
          "type": "text",
          "notnull": true
        },
        {
          "name": "kind",
          "type": "text",
          "notnull": true
        },
        {
          "name": "body",
          "type": "text",
          "notnull": true
        },
        {
          "name": "at",
