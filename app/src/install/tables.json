      "source": {
        "table": "cycle",
        "column": "mode"
      },
      "columns": [
        {
          "name": "task",
          "type": "text",
          "notnull": true
        },
        {
          "name": "cycle",
          "type": "text",
          "notnull": true
        },
        {
          "name": "unit",
          "type": "integer",
          "notnull": true
        },
        {
          "name": "from_cycle",
          "type": "text"
        },
        {
          "name": "from_unit",
          "type": "integer"
        },
        {
          "name": "agent",
          "type": "text",
          "notnull": true
        },
        {
          "name": "instance",
          "type": "text",
          "notnull": true
        },
        {
          "name": "place",
          "type": "text",
          "notnull": true
        },
        {
          "name": "at",
          "type": "integer",
          "notnull": true
        },
        {
          "name": "done",
