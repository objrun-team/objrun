      ]
    },
    {
      "_": "智能体上下文表：agent 表里有几个智能体就建几张。",
      "pattern": "agent_{}_ctx",
      "source": {
        "table": "agent",
        "column": "name"
      },
      "columns": [
        {
          "name": "instance",
          "type": "text",
          "notnull": true
        },
        {
          "name": "task",
          "type": "text",
          "notnull": true
        },
        {
          "name": "unit",
          "type": "integer",
          "notnull": true
        },
        {
          "name": "place",
          "type": "text",
          "notnull": true
        },
