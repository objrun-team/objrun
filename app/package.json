{
  "name": "tgengin",
  "version": "1.0.0",
  "description": "TgEngin —— 一个程序：装表、起库、跑循环",
  "scripts": {
    "start": "TGENGIN_CONFIG=../config.yaml bun --env-file=../.env src/main.ts",
    "check": "tsc -p tsconfig.json",
    "verify": "bun run check && bun run build",
    "build": "bun run build:win && bun run build:mac && bun run build:mac-x64",
    "build:win": "bun build --compile --target=bun-windows-x64 --outfile=../dist/tgengin-win-x64.exe src/main.ts",
    "build:mac": "bun build --compile --target=bun-darwin-arm64 --outfile=../dist/tgengin-mac-arm64 src/main.ts",
    "build:mac-x64": "bun build --compile --target=bun-darwin-x64 --outfile=../dist/tgengin-mac-x64 src/main.ts"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
