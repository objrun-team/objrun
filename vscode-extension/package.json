{
  "name": "tgengin", "displayName": "TgEngin", "version": "0.1.0", "publisher": "tgengin-local",
  "description": "TgEngin 本地任务工作台：启动引擎、发布任务、查看消息和执行树。",
  "engines": {"vscode": "^1.90.0"}, "categories": ["Machine Learning"],
  "main": "./extension.js", "extensionKind": ["workspace"],
  "capabilities": {"untrustedWorkspaces": {"supported": false}, "virtualWorkspaces": {"supported": false}},
  "contributes": {
    "commands": [
      {"command":"tgengin.open","title":"TgEngin: 打开任务面板"},
      {"command":"tgengin.start","title":"TgEngin: 启动 / 连接引擎"},
      {"command":"tgengin.newTask","title":"TgEngin: 新建任务"},
      {"command":"tgengin.selection","title":"TgEngin: 用选中代码创建任务"},
      {"command":"tgengin.token","title":"TgEngin: 设置连接令牌"},
      {"command":"tgengin.refresh","title":"TgEngin: 刷新任务","icon":"$(refresh)"}
    ],
    "viewsContainers":{"activitybar":[{"id":"tgengin","title":"TgEngin","icon":"media/icon.svg"}]},
    "views":{"tgengin":[{"id":"tgengin.tasks","name":"任务"}]},
    "viewsWelcome":[{"view":"tgengin.tasks","contents":"[启动 / 连接引擎](command:tgengin.start)\n[打开任务面板](command:tgengin.open)\n[新建任务](command:tgengin.newTask)"}],
    "menus":{"view/title":[{"command":"tgengin.refresh","when":"view == tgengin.tasks","group":"navigation"}],"editor/context":[{"command":"tgengin.selection","when":"editorHasSelection && isWorkspaceTrusted"}]},
    "configuration":{"title":"TgEngin","properties":{
      "tgengin.endpoint":{"type":"string","default":"http://127.0.0.1:7802/api","scope":"machine","description":"引擎 API 地址（含 /api）。"},
      "tgengin.configPath":{"type":"string","default":"/Users/zz/工作/TgEngin/.scratch/vscode/config.yaml","scope":"machine","description":"插件专用引擎配置，使用独立数据库。"},
      "tgengin.engineRoot":{"type":"string","default":"/Users/zz/工作/TgEngin","scope":"machine","description":"本地 TgEngin 源码目录。"},
      "tgengin.bunPath":{"type":"string","default":"/Users/zz/工作/TgEngin/.vscode-build/node_modules/.bin/bun","scope":"machine","description":"Bun 可执行文件路径。"}
    }}
  }
}
