 """Strict v2-only audit; explicitly separate infrastructure exceptions from violations."""
 import argparse,hashlib,json,pathlib,sqlite3
+
+# Audit a byte-for-byte SQLite/WAL snapshot so read-only SQLite recovery cannot
+# mutate a frozen shared-memory sidecar, including on Windows.
+import contextlib,shutil,tempfile
+@contextlib.contextmanager
+def readonly_snapshot(db):
+    with tempfile.TemporaryDirectory(prefix='srbench-audit-') as td:
+        copy=pathlib.Path(td)/db.name
+        for suffix in ['', '-wal', '-shm']:
+            source=db.with_name(db.name+suffix)
+            if source.exists():shutil.copyfile(source,copy.with_name(copy.name+suffix))
+        connection=sqlite3.connect('file:'+copy.as_posix()+'?mode=ro',uri=True)
+        try:yield connection
+        finally:connection.close()
+
